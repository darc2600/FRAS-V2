services:
  backend:
    build:
      context: .
      dockerfile: Dockerfile
    restart: unless-stopped
    env_file:
      - .env
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - DATASET_PATH=/app/dataset
    volumes:
      - ./data:/app/data
      # mount the host dataset directory (writable) and the repo into the container
      - /home/frasijbmapua/FRAS/dataset:/app/dataset:rw
      - ./:/app:rw
    ports:
      - "8000:8000"
    depends_on:
      - db

  frontend:
    image: nginx:stable-alpine
    restart: unless-stopped
    volumes:
      - ./facial-attendance/dist/facial-attendance:/usr/share/nginx/html:ro
    ports:
      - "8080:80"

  db:
    image: postgres:15
    restart: unless-stopped
    environment:
      - POSTGRES_USER=fras_user
      - POSTGRES_PASSWORD=change_me
      - POSTGRES_DB=frasdb
    volumes:
      - ./pgdata:/var/lib/postgresql/data
    ports:
      - "5432:5432"
