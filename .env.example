# FRAS Environment Template
# Copy this file to .env and replace the values before running/deploying.

FRAS_ENV=development

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database
# Recommended current demo/local setting:
DATABASE_URL=sqlite:///attendance.db

# Optional PostgreSQL deployment example:
# DATABASE_URL=postgresql://fras_user:replace-password@localhost:5432/frasdb

# Storage
DATASET_PATH=dataset

# CORS / App URLs
FRONTEND_ORIGIN=http://localhost:4200
BACKEND_ORIGIN=http://127.0.0.1:8000
