# FRAS production/demo environment template
# Copy this file to .env and replace the values before running Docker.

FRAS_ENV=production

# Generate a long random secret. Example command:
# python scripts/generate_secret.py
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# Official demo database mode: SQLite
# The docker-compose file mounts ./attendance.db to /app/attendance.db.
DATABASE_URL=sqlite:////app/attendance.db
SQLITE_DB_PATH=/app/attendance.db

# Face image dataset directory inside the container.
DATASET_PATH=/app/dataset

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional future PostgreSQL format. Do not enable unless the schema/data migration is ready.
# DATABASE_URL=postgresql://fras_user:replace-password@db:5432/frasdb
# POSTGRES_USER=fras_user
# POSTGRES_PASSWORD=replace-password
# POSTGRES_DB=frasdb
