# FRAS production/demo environment template
# Copy this file to .env and replace the values before running Docker.

FRAS_ENV=production

# Generate a long random secret. Example command:
# python scripts/generate_secret.py
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# Official production/demo database mode: PostgreSQL.
# Keep these values in sync. Use a stronger password on the VPS.
POSTGRES_USER=fras_user
POSTGRES_PASSWORD=replace-this-with-a-strong-postgres-password
POSTGRES_DB=frasdb
DATABASE_URL=postgresql://fras_user:replace-this-with-a-strong-postgres-password@db:5432/frasdb

# Face image dataset directory inside the container.
DATASET_PATH=/app/dataset

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-domain.example
